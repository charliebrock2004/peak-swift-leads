# Peak Swift Leads — environment variables
#
# This app does not need any secrets to run locally.
# Leads are stored in the browser (localStorage). Auth is off.
#
# Copy this file to .env if you later enable a database or sign-in.
# Never commit a real .env file.

# Auth is disabled for this lead sheet.
VITE_AUTH_ENABLED=false

# Optional Postgres URL (Neon or any Postgres). Leave unset to use
# the built-in PGLite fallback. Not required for the lead sheet.
# DATABASE_URL=postgres://USER:PASSWORD@HOST/DB

# Only needed if you turn auth on.
# BETTER_AUTH_SECRET=
# BETTER_AUTH_URL=http://localhost:8080
# GROK_AUTH_CLIENT_ID=
# GROK_AUTH_CLIENT_SECRET=
# GROK_AUTH_ISSUER=
