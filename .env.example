# Peak Swift Leads — environment variables
#
# The app is local-first: it always keeps a full copy of the sheet in the
# browser. When a database is configured it also syncs that sheet to your
# account, so the same leads are there on your phone and your laptop.
#
# Never commit a real .env file.

# Sign-in for the local workspace. Left off here: with no DATABASE_URL the
# server resolves the shared dev owner, which is what the local/preview copy
# of the sheet belongs to. The deploy platform sets this itself.
VITE_AUTH_ENABLED=false

# Injected automatically in Grok Build preview and deploy.
# Needed only if you run the app yourself outside Grok.
# Server-only — never prefix with VITE_.
# XAI_API_KEY=

# Postgres. Set it and leads sync durably; leave it unset and the server falls
# back to an in-memory database (fine for local work — it resets on restart),
# with the browser copy still holding everything.
# DATABASE_URL=postgres://USER:PASSWORD@HOST/DB

# ── Sign-in, when deployed outside the Grok platform ─────────────────────────
# Local work needs none of these, and neither does a deployment: DATABASE_URL is
# the only variable required. Each of these overrides a derived default.
#
# Only forces sign-in OFF, and only when no database is configured (local dev).
# With DATABASE_URL present, sign-in is on regardless.
# VITE_AUTH_ENABLED=false
# Derived from DATABASE_URL when unset. Set it to rotate sessions on their own:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# BETTER_AUTH_SECRET=
# Falls back to the URL Vercel injects. Set it for a custom domain, no trailing slash.
# BETTER_AUTH_URL=https://your-app.vercel.app
# The only address allowed to use the app. Unset, the first account created owns
# it. Comma-separate to allow more than one.
# APP_OWNER_EMAIL=you@example.com

# ── Outreach (Phase 3) ───────────────────────────────────────────────────────
# Gmail sending needs your own Google Cloud OAuth client. See the README for the
# one-time setup. Server-only — never prefix either of these with VITE_, and
# never commit real values.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Optional: pin the mailbox outreach may send from. Connecting any other Google
# account is then refused outright.
# GMAIL_SENDER=PeakSwiftStudio@gmail.com

# Optional: only needed when the redirect URI is not <origin>/oauth/gmail.
# GOOGLE_REDIRECT_URI=

# Optional: AI-written emails. Without it outreach uses the templates and says
# so on screen — nothing breaks.
# XAI_API_KEY=

# TEST ONLY. These point Gmail and OAuth at a local stand-in and must never be
# set in production:
# GOOGLE_OAUTH_BASE=
# GMAIL_API_BASE_URL=

# ── Website discovery through public web search (optional) ───────────────────
#
# Most small businesses have no website on their OpenStreetMap or Companies
# House listing, and many that do use a domain that looks nothing like their
# name — guessing cannot reach those. A search key is what finds them.
#
# Set ONE of these. Tavily is tried first, then Brave, then Bing. With neither set, discovery still
# works: it falls back to the listing and to domain candidates, and the app
# reports SEARCH_PROVIDER_UNAVAILABLE so you know why a lead was missed.
#
# Server-only. Never prefixed VITE_, so it cannot reach the browser.
#   Brave: https://brave.com/search/api/
#   Bing:  https://www.microsoft.com/en-us/bing/apis/bing-web-search-api
#   Tavily: https://tavily.com/  (POST /search, bearer token, 1 credit per
#           basic search; it also returns the page text it fetched, which lets
#           an address be read without spending one of our own page fetches)
TAVILY_API_KEY=
BRAVE_SEARCH_API_KEY=
BING_SEARCH_API_KEY=
